*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/
build/

# Virtual environments
dai/
venv/
env/
.env

# Chrome driver downloads (auto-installed by chromedriver-autoinstaller)
*/chromedriver*
chromedriver*
*/chromedriver
138/

# Screenshots and test data
*.png
*.jpg
*.jpeg
screenshots/

# Logs
*.log
d-ai-trader.log

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Database
*.db
*.sqlite
*.sqlite3

# Jupyter
.ipynb_checkpoints/

# System directories (don't commit)
usr/
home/

# Knowledge bases (800-900 generated files — never commit)
Knowledge_Bases/

# Agent SOUL / MEMORY — DB is canonical; on-disk files are live mirrors
# that may contain trade-specific lessons. Defaults end in .default.md and
# ARE committed; live mirrors (SOUL.md / MEMORY.md) are gitignored.
agents/*/SOUL.md
agents/*/MEMORY.md
!agents/*/SOUL.default.md
!agents/*/MEMORY.default.md

# Backup files from cleanup attempts
*.bak.*
*.new

# Temporary/generated files
sitecustomize.py
run_dashboard_patched.py
requirements.fragment.txt
startup_config.py
schwab_tokens.json
schwab_tokens.json

# Policy graph store scratch (agents/*/policy-graph/<config>/): lock, build temp, partial writes
agents/*/policy-graph/*/.lock
agents/*/policy-graph/*/.tmp-*
agents/*/policy-graph/**/*.part

# Policy graph: git tracks only the committed baseline (baseline/v0) and a copy of the ACTIVE
# version (latest/). Per-config history (agents/*/policy-graph/<config_hash>/v*) is the machine's
# own learning — keep it local; push it deliberately if ever wanted.
agents/*/policy-graph/*
!agents/*/policy-graph/baseline/
!agents/*/policy-graph/latest/
