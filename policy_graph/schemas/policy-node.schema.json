{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d-ai-trader.local/schemas/policy-node.schema.json",
  "title": "Policy graph node frontmatter",
  "description": "Frontmatter of one <id>.md node file under agents/<dir>/policy-graph/<config_hash>/v<N>/ (schema 1). The body is the verbatim slice text; sep_before + body + sep_after concatenated in manifest.compile_order reproduces the stored prompt field byte-for-byte.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "version", "agent", "title", "node_type", "polarity", "polarity_source", "field", "order", "owner", "status", "compiled", "locked", "provenance", "sep_before", "sep_after", "body_sha256", "tags", "tickers"],
  "properties": {
    "id": {"type": "string", "pattern": "^(DA|SA|FA)(\\.[a-z0-9_]+)+$"},
    "version": {"type": "string", "description": "version stamp <agent_type>.<config_hash>.v<N>"},
    "agent": {"type": "string", "enum": ["DeciderAgent", "SummarizerAgent", "FeedbackAgent"]},
    "title": {"type": "string"},
    "node_type": {"type": "string", "enum": ["root", "template", "field", "section", "rule", "lesson", "entry", "reminder", "identity", "note", "code", "data", "ltm", "ticker", "concept"]},
    "polarity": {"type": "string", "enum": ["gate", "action", "caution", "principle", "evidence", "structure", "mixed"]},
    "polarity_source": {"type": "string", "enum": ["override", "heuristic", "authored"]},
    "parent": {"type": ["string", "null"], "description": "null only for the single root node"},
    "field": {"type": ["string", "null"], "enum": ["system_prompt", "user_prompt_template", "strategy_directives", "soul", "memory", null]},
    "order": {"type": "integer", "minimum": 0, "description": "display order among siblings — a mirror, never the compile authority"},
    "owner": {"type": "string", "enum": ["db", "default-file", "code", "decider_memory", "runtime", "generated"]},
    "status": {"type": "string", "enum": ["active", "inherited", "inert", "read-only", "generated", "inactive"]},
    "compiled": {"type": "string", "enum": ["stored", "effective-only", "never"]},
    "locked": {"type": "boolean"},
    "provenance": {"type": "string", "description": "prompt_versions#<id> | <default file>@<sha> | <source_file>:<symbol> | decider_memory#<id> | generated"},
    "sep_before": {"type": "string"},
    "sep_after": {"type": "string"},
    "body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "tickers": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{1,5}$"}},
    "inherited_from": {"type": ["string", "null"]},
    "inherited_git_sha": {"type": ["string", "null"]},
    "inherited_resolution": {"type": ["string", "null"], "enum": ["git-blob-at-created_at", "worktree", "live-mirror", null]},
    "source_file": {"type": ["string", "null"]},
    "source_symbol": {"type": ["string", "null"]},
    "source_lines": {"type": ["string", "null"]},
    "code_sha": {"type": ["string", "null"]},
    "git_sha": {"type": ["string", "null"]},
    "condition": {"type": ["string", "null"]},
    "fires": {"type": ["boolean", "null"]},
    "position": {"type": ["string", "null"], "enum": ["user_template_tail", "user_prompt_dynamic", "user_prompt_tail", "system_tail", "system_base", "user_prompt_head", null]},
    "kind": {"type": ["string", "null"]},
    "source": {"type": ["string", "null"]},
    "weight": {"type": ["number", "null"]},
    "ticker": {"type": ["string", "null"]},
    "row_created_at": {"type": ["string", "null"]},
    "row_updated_at": {"type": ["string", "null"]},
    "injected": {"type": ["boolean", "null"]},
    "active": {"type": ["boolean", "null"]},
    "edges": {
      "type": "array",
      "description": "authored edges (Phase 2); subtype_of is never authored here — hierarchy truth is `parent`",
      "items": {
        "type": "object",
        "required": ["type", "to"],
        "properties": {
          "type": {"type": "string", "enum": ["exception_to", "boundary_with", "confused_with", "clarifies", "example_of", "negative_example_of", "includes", "related_to", "cites", "overlaps", "constrains", "enforced_by"]},
          "to": {"type": "string"},
          "via": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  }
}
